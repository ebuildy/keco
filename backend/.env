# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=05ff6c4dfb32824240d222fbd4bea1af
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app: read side / Search (AGENTS.md §5, §11) ###
# Read by App\Search (Phase 4+: projector upserts, Api/Backoffice reads). Not wired yet — Phase 0
# only scaffolds the Search/ namespace. Local dev default matches infra/compose.yml's Meilisearch.
MEILI_HOST=http://127.0.0.1:7700
# The master key. Local dev placeholder only — in any non-local environment this goes through
# Symfony's secrets vault (`bin/console secrets:set MEILI_MASTER_KEY`), never plain .env (§12).
MEILI_MASTER_KEY=changeme-local-dev-only
###< app: read side / Search ###

###> app: backoffice auth (AGENTS.md §12, Phase 4) ###
# A password hash (Symfony PasswordHasher), compared constant-time by the admin authenticator.
# Empty by design: there is no admin login until Phase 4. Generate a real one with
# `bin/console security:hash-password` once that authenticator exists.
ADMIN_PASSWORD_HASH=
# Bearer token accepted by /api/commands/* and EasyAdmin's command actions as the non-session
# alternative (§11, §12, Phase 4). Placeholder — replace locally via .env.local, vault in prod.
COMMAND_TOKEN=changeme-local-dev-only
###< app: backoffice auth ###

###> app: crawler / GitHub (AGENTS.md §4.2, §14, Phase 2) ###
# A GitHub personal access token, read by the crawler's HttpClient-based REST client (Phase 2)
# and shared with the analyzer's extra GitHub signal calls (Phase 3) under the same quota.
GITHUB_TOKEN=
# Share of the 5000 points/hour core REST quota reserved for the crawler; the analyzer's GitHub
# calls (Pass 2 signals) get the remainder. Read as a bound Symfony parameter in Phase 3 (§4.3,
# §14: "two components spending the same quota without a contract is how crawls start failing").
GITHUB_QUOTA_CRAWLER_SHARE=0.8
###< app: crawler / GitHub ###

###> app: analyzer / LLM fallback (AGENTS.md §4.3 Pass 3, Phase 3) ###
# The cheap model used only when confidence < 0.7 or `kind` is ambiguous — read as the
# `analyzer.model` parameter by Phase 3's Analyzer\Llm HttpClient adapter. Deliberately a
# placeholder: Pass 3 should be a minority of the corpus, and picking a model is that phase's
# decision, not this one's.
ANALYZER_MODEL=
###< app: analyzer / LLM fallback ###

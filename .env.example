# Keco environment. Each variable names the surface that reads it (§12).
# Copy to .env: `mise run env:init`

# ── GitHub — crawler + analyzer only. Never read by apps/web. ────────────────
# Classic PAT with public_repo scope. 5000 points/hour, shared by both workers.
GITHUB_TOKEN=
# Share of the hourly budget reserved for the crawler; the rest is the analyzer's.
GITHUB_QUOTA_CRAWLER_SHARE=0.8

# ── Cache (write model) — workers write, apps/web only reads ─────────────────
# A directory, not a service. Relative paths resolve against the workspace root, so every
# worker and the web app share one cache. Object storage comes in v2 (ROADMAP.md).
CACHE_DIR=.cache

# ── Meilisearch (read models) ────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
# Server-side only: projector (write) and server components. Never sent to a browser.
MEILI_MASTER_KEY=keco-dev-master-key
# Search-only key, scoped to the `tools` index. Safe in the browser bundle.
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=

# ── Workers ──────────────────────────────────────────────────────────────────
# Deterministic sharding: hash(repo) % SHARD_COUNT == SHARD_INDEX (§4).
SHARD_COUNT=1
SHARD_INDEX=0
LOG_LEVEL=info

# ── AI — analyzer pass 3 fallback + chatbot (v2) ─────────────────────────────
ANTHROPIC_API_KEY=
ANALYZER_MODEL=claude-haiku-4-5-20251001

# ── Backoffice auth — apps/web (admin) only ──────────────────────────────────
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed into /admin.
ADMIN_LOGINS=
# Bearer token accepted by /api/commands/* in place of an admin session.
COMMAND_TOKEN=

# Keco environment. Each variable names the surface that reads it (§12).
# Copy to .env: `mise run env:init`

# ── GitHub — crawler + analyzer only. Never read by apps/web. ────────────────
# Classic PAT with public_repo scope. 5000 points/hour, shared by both workers.
GITHUB_TOKEN=
# Share of the hourly budget reserved for the crawler; the rest is the analyzer's.
GITHUB_QUOTA_CRAWLER_SHARE=0.8

# ── Cache (write model) — workers write, apps/web only reads ─────────────────
# A directory, not a service. Relative paths resolve against the workspace root, so every
# worker and the web app share one cache. Object storage comes in v2 (ROADMAP.md).
CACHE_DIR=.cache

# ── Meilisearch (read models) ────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
# Server-side only: the projector (write) and apps/api (read). Never sent to a browser.
MEILI_MASTER_KEY=keco-dev-master-key

# ── Portal bundle — apps/web ─────────────────────────────────────────────────
# Vite inlines every VITE_-prefixed variable into the shipped bundle at build time. Anything
# with this prefix is public, permanently, in every deployed artifact — never prefix a secret,
# and rotating one of these means a rebuild and a redeploy (§12).
VITE_MEILI_HOST=http://localhost:7700
# Search-only key, scoped to the `tools` index — never the master key above. Left blank here
# on purpose: `mise run setup` (via `mise run search:key`) mints or fetches this key from
# Meilisearch and writes the real value into .env for you. It is safe to be public — that is
# the whole point of a search-only key — so it is fine to see it committed to *your* .env, but
# never hand-copy the master key into this variable.
VITE_MEILI_SEARCH_KEY=
# Set to 1 to run the portal against the in-browser mock backend (apps/web/src/mocks).
# Read by apps/web only, and only under `vite dev` — a production build eliminates the branch,
# so this has no effect on a built bundle. Fabricated data: never point a real deployment here.
VITE_MOCK=

# ── apps/api ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Absolute base for canonical links and the sitemap. Read by the prerender too.
SITE_URL=http://localhost:3000
# Where `vite build` put the portal; served by @fastify/static.
WEB_DIST=apps/web/dist
# Trust X-Forwarded-For from the reverse proxy in front of this process, so the per-IP rate
# limiter on /api/v1/* keys on the caller, not the proxy. Only set true when apps/api is
# genuinely behind a proxy you control — true without one lets a caller spoof
# X-Forwarded-For and evade the limiter (§12).
TRUST_PROXY=false

# ── Backoffice auth — apps/api admin routes only ─────────────────────────────
# Signs the admin session cookie. 32 characters minimum.
SESSION_SECRET=
# scrypt$<salt>$<key> — generate with: mise run admin:hash -- --password 'your-password'
ADMIN_PASSWORD_HASH=
# Bearer token accepted by /api/commands/* in place of an admin session.
COMMAND_TOKEN=

# ── Workers ──────────────────────────────────────────────────────────────────
# Deterministic sharding: hash(repo) % SHARD_COUNT == SHARD_INDEX (§4).
SHARD_COUNT=1
SHARD_INDEX=0
LOG_LEVEL=info

# ── AI — analyzer pass 3 fallback + chatbot (v2) ─────────────────────────────
ANTHROPIC_API_KEY=
ANALYZER_MODEL=claude-haiku-4-5-20251001
